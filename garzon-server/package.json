{
  "name": "garzon-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MongoDB and Express backend for the Bulldogs Exchange activity.",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "seed": "node scripts/seedDatabase.js",
    "validate:models": "node scripts/validateModels.js",
    "test:images": "node --test tests/productImages.test.js",
    "verify:cloudinary": "node tests/verifyCloudinary.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:audit": "node --test tests/auditRegression.test.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "mongodb-memory-server-core": "^11.3.0",
    "typescript": "^7.0.2"
  }
}
